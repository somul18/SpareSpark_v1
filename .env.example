PORT=3000
SPARESPARK_DB=./data/sparespark.db
# Require X-API-Key on all API calls (recommended once exposed beyond localhost)
SPARESPARK_API_KEY=
# Optional: Claude writes the explanation and chat answers, grounded on retrieved evidence
ANTHROPIC_API_KEY=
SPARESPARK_MODEL=claude-opus-5-5
# Demo pacing and switches
SPARESPARK_STEP_MS=1500
SPARESPARK_DEMO_REPAIR_MS=2500
SPARESPARK_DEMO_VENDOR_MS=3000
SPARESPARK_DEMO=on
SPARESPARK_SLA_MINUTES=240
# ServiceNow plugin webhook (stage updates back to the instance)
SPARESPARK_WEBHOOK_URL=
SPARESPARK_WEBHOOK_TOKEN=
SPARESPARK_WEBHOOK_USER=
SPARESPARK_WEBHOOK_PASSWORD=
SPARESPARK_CORS_ORIGIN=
